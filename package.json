{
  "name": "agentlift",
  "version": "0.0.0",
  "private": true,
  "description": "Measure the real impact of agent extensions.",
  "type": "module",
  "bin": {
    "agentlift": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run build && npm test",
    "demo": "tsx src/cli.ts impact --config examples/agentlift.yaml"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
